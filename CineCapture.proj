<Project DefaultTargets="BuildRelease">
  <PropertyGroup>
    <Configuration Condition="'$(Configuration)' == ''">Release</Configuration>
    <Platform>x64</Platform>
    <ManagedFramework>netstandard2.1</ManagedFramework>
    <SourceDirectory>$(MSBuildProjectDirectory)</SourceDirectory>
    <ArtifactsDirectory>$(MSBuildThisFileDirectory)artifacts</ArtifactsDirectory>
    <PackageDirectory>$(ArtifactsDirectory)\package</PackageDirectory>
    <ILRepackVersion>2.0.48</ILRepackVersion>
    <ILRepackDirectory>$(ArtifactsDirectory)\tools\ILRepack</ILRepackDirectory>
    <ILRepackExecutable>$(ILRepackDirectory)\tools\ILRepack.exe</ILRepackExecutable>
    <PackageScript>$(MSBuildThisFileDirectory)build\Package.ps1</PackageScript>
    <CameraOperatorProject>$(SourceDirectory)\CameraOperator\CameraOperator.csproj</CameraOperatorProject>
    <MediaWriterProject>$(SourceDirectory)\FFmpegMediaWriter\FFmpegMediaWriter.csproj</MediaWriterProject>
    <RecorderProject>$(SourceDirectory)\UnityRuntimeCameraRecorder\UnityRuntimeCameraRecorder.csproj</RecorderProject>
    <VideoEncoderProject>$(SourceDirectory)\Direct3DVideoEncoder\Direct3DVideoEncoder.vcxproj</VideoEncoderProject>
    <MetadataProject>$(MSBuildThisFileDirectory)CineCapture.Metadata.csproj</MetadataProject>
  </PropertyGroup>

  <Target Name="ValidateInputs">
    <Error Condition="'$(UnityManagedPath)' == '' Or !Exists('$(UnityManagedPath)\UnityEngine.CoreModule.dll')"
           Text="Supply UnityManagedPath pointing to Unity's managed UnityEngine assembly directory." />
    <Error Condition="'$(NativeMSBuildPath)' == '' Or !Exists('$(NativeMSBuildPath)')"
           Text="Supply NativeMSBuildPath pointing to Visual Studio MSBuild.exe." />
    <Error Condition="!Exists('$(CameraOperatorProject)')" Text="Initialize the CameraOperator submodule." />
    <Error Condition="!Exists('$(MediaWriterProject)')" Text="Initialize the FFmpegMediaWriter submodule." />
    <Error Condition="!Exists('$(RecorderProject)')" Text="Initialize the UnityRuntimeCameraRecorder submodule." />
    <Error Condition="!Exists('$(VideoEncoderProject)')" Text="Initialize the Direct3DVideoEncoder submodule." />
    <Error Condition="!Exists('$(MetadataProject)')" Text="The CineCapture metadata project is missing." />
    <Error Condition="'$(UnityVersion)' == ''" Text="Supply the UnityVersion release metadata property." />
    <Error Condition="!Exists('$(PackageScript)')" Text="The release packaging script is missing." />
  </Target>

  <Target Name="Prepare" DependsOnTargets="ValidateInputs">
    <RemoveDir Directories="$(PackageDirectory)" />
    <MakeDir Directories="$(PackageDirectory)" />
  </Target>

  <Target Name="BuildNative" DependsOnTargets="Prepare">
    <Exec Command="&quot;$(NativeMSBuildPath)&quot; &quot;$(VideoEncoderProject)&quot; /m /t:Build /p:Configuration=$(Configuration) /p:Platform=$(Platform) /v:minimal" />
  </Target>

  <Target Name="BuildManaged" DependsOnTargets="Prepare">
    <MSBuild Projects="$(MetadataProject)"
             Targets="Restore;Build"
             Properties="Configuration=$(Configuration)"
             RemoveProperties="Platform" />
    <MSBuild Projects="$(CameraOperatorProject)"
             Targets="Restore;Build"
             Properties="Configuration=$(Configuration);TargetFramework=$(ManagedFramework);UnityManagedPath=$(UnityManagedPath);CopyLocalLockFileAssemblies=true"
             RemoveProperties="Platform" />
    <MSBuild Projects="$(MediaWriterProject)"
             Targets="Restore;Build"
             Properties="Configuration=$(Configuration)"
             RemoveProperties="Platform" />
    <MSBuild Projects="$(RecorderProject)"
             Targets="Restore;Build"
             Properties="Configuration=$(Configuration);UnityManagedPath=$(UnityManagedPath)"
             RemoveProperties="Platform" />
  </Target>

  <Target Name="MergeManaged" DependsOnTargets="BuildManaged">
    <Exec Condition="!Exists('$(ILRepackExecutable)')"
          Command="nuget install ILRepack -Version $(ILRepackVersion) -OutputDirectory &quot;$(ArtifactsDirectory)\tools&quot; -ExcludeVersion -NonInteractive"
          WorkingDirectory="$(MSBuildThisFileDirectory)" />
    <Exec WorkingDirectory="$(MSBuildThisFileDirectory)"
          Command="&quot;$(ILRepackExecutable)&quot; /ndebug &quot;/lib:$(UnityManagedPath)&quot; /out:&quot;$(PackageDirectory)\CineCapture.dll&quot; &quot;$(MSBuildThisFileDirectory)bin\$(Configuration)\netstandard2.1\CineCapture.dll&quot; &quot;$(SourceDirectory)\UnityRuntimeCameraRecorder\bin\$(Configuration)\netstandard2.1\UnityRuntimeCameraRecorder.dll&quot; &quot;$(SourceDirectory)\FFmpegMediaWriter\bin\$(Configuration)\netstandard2.0\FFmpegMediaWriter.dll&quot; &quot;$(SourceDirectory)\CameraOperator\bin\$(Configuration)\$(ManagedFramework)\CameraOperator.dll&quot; &quot;$(SourceDirectory)\CameraOperator\bin\$(Configuration)\$(ManagedFramework)\YamlDotNet.dll&quot;" />
  </Target>

  <Target Name="PreparePackage" DependsOnTargets="BuildNative;MergeManaged">
    <ItemGroup>
      <PackageFile Include="$(SourceDirectory)\Direct3DVideoEncoder\build\$(Platform)\$(Configuration)\Direct3DVideoEncoder.dll" />
      <PackageFile Include="$(MSBuildThisFileDirectory)LICENSE" />
      <PackageFile Include="$(MSBuildThisFileDirectory)README.md" />
    </ItemGroup>
    <Copy SourceFiles="@(PackageFile)" DestinationFolder="$(PackageDirectory)" />
  </Target>

  <Target Name="BuildRelease" DependsOnTargets="PreparePackage" />

  <Target Name="Package" DependsOnTargets="BuildRelease">
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(PackageScript)&quot; -RepositoryDirectory &quot;$(MSBuildProjectDirectory)&quot; -PackageDirectory &quot;$(PackageDirectory)&quot; -ArtifactsDirectory &quot;$(ArtifactsDirectory)&quot; -UnityVersion &quot;$(UnityVersion)&quot;" />
  </Target>
</Project>
